DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=public"
NODE_ENV=development
PORT=3000
# Orígenes (navegadores) que pueden llamar a la API, separados por coma
CORS_ORIGINS=http://localhost:5173
# URL pública del marketplace (se usa en el campo url.web del contrato)
FRONTEND_URL=http://localhost:5173

# Autenticación (tokens JWT con los scopes del contrato)
# Clave larga y secreta para firmar los tokens. En producción es OBLIGATORIA.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
# Duración del token en segundos (3600 = 1 hora)
JWT_EXPIRES_IN_SECONDS=3600
# Cuenta del operador (administrador del catálogo). Se crea sola al arrancar si no existe.
OPERADOR_NOMBRE=Operador Atracciones
OPERADOR_EMAIL=admin@atracciones.ec
OPERADOR_PASSWORD=cambia-esta-clave
